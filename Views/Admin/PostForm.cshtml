@model ThrottleBlog.ViewModels.PostFormViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Editar Post" : "Novo Post";
}

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<style>
    @@keyframes productEntry {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
    }
</style>

<form asp-action="SavePost" method="post" id="post-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="IsFeatured" id="is-featured-input" />

    
@* Topbar  *@

    <div class="form-topbar">
        <div>
            <h2>@ViewData["Title"]</h2>
            <div class="form-topbar-meta">
                <span class="status-pill @(Model.Status.ToString() == "Published" ? "published" : "draft")" id="status-pill">
                    @(Model.Status.ToString() == "Published" ? "Publicado" : "Rascunho")
                </span>
                <span class="form-topbar-timestamp">@(isEdit ? "Editando post existente" : "Criando novo post")</span>
            </div>
        </div>
        <div class="form-topbar-actions">
            <a href="/admin/posts" class="btn-secondary">← Voltar</a>
            <button type="submit" class="btn-primary">✓ Salvar Post</button>
        </div>
    </div>

    
@* Throttle strip — progresso de leitura ligado à contagem de palavras  *@

    <div class="throttle-strip">
        <div class="throttle-track"><div class="throttle-fill" id="throttle-fill" style="width:0%"></div></div>
        <div class="throttle-labels">
            <span id="throttle-words">0 palavras</span>
            <span id="throttle-time">leitura ~0min</span>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" style="margin-top:10px; background:#1a0500; border:1px solid #ff3c00; color:#ff3c00; padding:10px 14px; border-radius:5px; font-size:13px;"></div>

    <div class="pf-grid">

        
@* COLUNA PRINCIPAL  *@

        <div class="pf-main">

            
@* Título  *@

            <div class="form-group">
                <label class="form-label">Título do Post *</label>
                <input class="form-input" asp-for="Title" style="font-size:17px; font-weight:700;" placeholder="Ex: ANÁLISE DO CAPACETE SHARK SPARTAN RS" />
                <span asp-validation-for="Title" class="field-error"></span>
            </div>

            
@* Excerpt  *@

            <div class="form-group">
                <label class="form-label">Resumo (Excerpt)</label>
                <input class="form-input" asp-for="Excerpt" placeholder="Breve introdução exibida nas listagens..." />
            </div>

            
@* Editor + Preview  *@

            <div class="form-group">
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:6px;">
                    <label class="form-label" style="margin:0;">Conteúdo do Artigo</label>
                    <span style="font-size:11px; color:#444;">Digite <kbd style="background:#1a1a1a;border:1px solid #333;padding:1px 5px;border-radius:3px;color:#888;font-size:11px;">/</kbd> para inserir blocos</span>
                </div>

                <div class="editor-shell">
                    
@* Tabs de modo  *@

                    <div class="editor-topbar">
                        <div class="editor-topbar-left">
                            <div class="editor-tab active" id="tab-split" onclick="setEditorMode('split')">Split</div>
                            <div class="editor-tab" id="tab-editor" onclick="setEditorMode('editor')">Editor</div>
                            <div class="editor-tab" id="tab-preview" onclick="setEditorMode('preview')">Preview</div>
                        </div>
                        <div class="editor-topbar-hint" id="word-count">0 palavras</div>
                    </div>

                    <div class="editor-split" id="editor-split">
                        <div class="panel-editor">
                            <div class="panel-subheader">Markdown</div>
                            <textarea id="editor-textarea" asp-for="Content"
                                placeholder="Escreva aqui...
/ para inserir blocos (título, tabela, produto, vídeo...)
Cole um link webriders.com.br para gerar card de produto automaticamente"></textarea>
                        </div>
                        <div class="panel-preview">
                            <div class="panel-subheader">Visualização ao Vivo</div>
                            <div class="preview-body" id="preview-render-area"></div>
                        </div>
                    </div>
                </div>
                <span asp-validation-for="Content" class="field-error"></span>
            </div>
        </div>

        
@* COLUNA LATERAL  *@

        <div class="pf-side">

            
@* Publicação  *@

            <div class="side-card">
                <div class="side-card-title">Publicação</div>

                <div class="form-group" style="margin-bottom:10px;">
                    <label class="form-label">Status</label>
                    <select class="filter-select" asp-for="Status" id="status-select">
                        <option value="Draft">Rascunho</option>
                        <option value="Published">Publicado</option>
                    </select>
                </div>

                <div class="form-group" style="margin-bottom:10px;">
                    <label class="form-label">Categoria *</label>
                    <select class="filter-select" asp-for="CategoryId">
                        <option value="">-- Selecione --</option>
                        @if (Model.Categories != null)
                        {
                            foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Tempo de Leitura (min)</label>
                    <input class="form-input" asp-for="ReadingTime" type="number" min="1" placeholder="Ex: 5" id="reading-time-input" />
                </div>
            </div>

            
@* Destaque  *@

            <div class="side-card">
                <div class="side-card-title">Destaque</div>
                <div class="featured-toggle-row @(Model.IsFeatured ? "is-active" : "")" id="featured-toggle" onclick="toggleFeatured()">
                    <div class="featured-label-group">
                        <div class="featured-icon">⭐</div>
                        <div>
                            <div class="featured-label-text">Post em Destaque</div>
                            <div class="featured-label-desc">Aparece na seção de destaques da categoria</div>
                        </div>
                    </div>
                    <div class="toggle-switch"></div>
                </div>
            </div>

            
@* Imagem de Capa  *@

            <div class="side-card">
                <div class="side-card-title">Imagem de Capa</div>

                
@* Preview  *@

                <div class="cover-preview" id="cover-preview-box">
                    @if (!string.IsNullOrEmpty(Model.FeaturedImage))
                    {
                        <img id="cover-img" src="@Model.FeaturedImage" />
                    }
                    else
                    {
                        <div class="cover-placeholder">
                            <span>🖼️</span>
                            Nenhuma imagem selecionada
                        </div>
                    }
                </div>

                <input type="hidden" asp-for="FeaturedImage" id="featured-image-input" />


<div class="form-group">
    <label asp-for="GalleryImages">
        Imagens da Galeria
        <small class="text-muted">(URLs separadas por vírgula — opcionais)</small>
    </label>

    @* Textarea facilita colar várias URLs *@
    <textarea asp-for="GalleryImages"
              class="form-control"
              rows="3"
              placeholder="https://cdn.exemplo.com/foto1.jpg, /uploads/foto2.webp, ..."></textarea>

    <span asp-validation-for="GalleryImages" class="text-danger"></span>

    <small class="form-text text-muted">
        A primeira imagem do carrossel é sempre a <strong>Imagem de Destaque</strong>.
        Adicione aqui imagens extras para compor a galeria (máx. 4000 chars).
    </small>
</div>

@* ── Preview dinâmico das URLs digitadas (opcional, JS puro) ── *@
<div id="galleryPreview" class="gallery-preview" style="display:none">
    <p class="preview-label">Preview da galeria:</p>
    <div id="galleryThumbsWrap" class="gallery-thumbs"></div>
</div>

@* ── CSS do preview ── *@
<style>
    .gallery-preview    { margin-top: .5rem; }
    .preview-label      { font-size: .8rem; color: #666; margin-bottom: .25rem; }
    .gallery-thumbs     { display: flex; flex-wrap: wrap; gap: 8px; }
    .gallery-thumbs img {
        width: 80px;
        height: 56px;
        object-fit: cover;
        border-radius: 6px;
        border: 2px solid #ddd;
    }
    .gallery-thumbs img.error { border-color: #e74c3c; opacity: .4; }
</style>

@* ── Script do preview ── *@
<script>
(function () {
    const galleryTextarea = document.getElementById('GalleryImages');
    const preview  = document.getElementById('galleryPreview');
    const thumbs   = document.getElementById('galleryThumbsWrap');
    const featInput = document.getElementById('featured-image-input'); // hidden field, não o url-input

    if (!galleryTextarea) return;

    function renderGalleryPreview() {
        const urls = [];
        const feat = featInput?.value?.trim();
        if (feat) urls.push(feat);

        galleryTextarea.value.split(',').forEach(u => {
            const t = u.trim();
            if (t) urls.push(t);
        });

        thumbs.innerHTML = '';

        if (urls.length === 0) {
            preview.style.display = 'none';
            return;
        }

        preview.style.display = 'block';
        urls.forEach((url, i) => {
            const img = document.createElement('img');
            img.src = url;
            img.alt = `Imagem ${i + 1}`;
            img.title = url;
            img.addEventListener('error', () => img.classList.add('error'));
            thumbs.appendChild(img);
        });
    }

    galleryTextarea.addEventListener('input', renderGalleryPreview);
    featInput?.addEventListener('change', renderGalleryPreview);
    renderGalleryPreview();
})();
</script>
                
@* Tabs upload / URL  *@

                <div class="cover-tabs">
                    <div class="cover-tab active" id="cover-tab-upload" onclick="switchCoverTab('upload')">📁 Upload</div>
                    <div class="cover-tab" id="cover-tab-url" onclick="switchCoverTab('url')">🔗 URL</div>
                </div>

                
@* Painel Upload  *@

                <div class="cover-upload-panel active" id="cover-panel-upload">
                    <input type="file" id="img-file-input" style="display:none;" accept="image/*" />
                    <button type="button" class="btn-upload" onclick="document.getElementById('img-file-input').click()">
                        📁 Selecionar arquivo...
                    </button>
                    <div id="upload-status"></div>
                </div>

                
@* Painel URL  *@

                <div class="cover-url-panel" id="cover-panel-url">
                    <div class="url-input-row">
                        <input type="url" id="cover-url-input" placeholder="https://exemplo.com/imagem.jpg" />
                        <button type="button" class="url-apply-btn" onclick="applyCoverUrl()">Usar</button>
                    </div>
                    <div style="font-size:11px; color:#444; margin-top:5px;">Cole a URL completa da imagem</div>
                </div>
            </div>

        </div>
    </div>
</form>


@* Menu Slash  *@

<div class="slash-menu" id="slash-menu">
    <div class="slash-menu-search">
        <input type="text" id="slash-search" placeholder="Filtrar blocos..." autocomplete="off" />
    </div>
    <div id="slash-items-container"></div>
</div>

@section Scripts {
<script>
// ═══════════════════════════════════════════════════════════════
//  THROTTLE BLOG — Post Form Editor
// ═══════════════════════════════════════════════════════════════

const textarea    = document.getElementById('editor-textarea');
const previewArea = document.getElementById('preview-render-area');
const slashMenu   = document.getElementById('slash-menu');
const slashSearch = document.getElementById('slash-search');
let productCache  = {};
let slashStart    = -1;       // posição do "/" que abriu o menu
let highlightIdx  = 0;
let visibleItems  = [];

// ── Definição de todos os comandos do menu slash ──────────────
const SLASH_COMMANDS = [
    { group: 'Texto', icon: 'H1', name: 'Título 1', desc: 'Título grande', syntax: '# ', cursor: 2 },
    { group: 'Texto', icon: 'H2', name: 'Título 2', desc: 'Título médio',  syntax: '## ', cursor: 3 },
    { group: 'Texto', icon: 'H3', name: 'Título 3', desc: 'Título pequeno', syntax: '### ', cursor: 4 },
    { group: 'Texto', icon: '¶',  name: 'Parágrafo', desc: 'Texto simples', syntax: '\n\n', cursor: 2 },
    { group: 'Texto', icon: '❝',  name: 'Citação', desc: 'Bloco de citação', syntax: '> ', cursor: 2 },
    { group: 'Texto', icon: '—',  name: 'Separador', desc: 'Linha horizontal', syntax: '\n---\n', cursor: 5 },
    { group: 'Lista', icon: '•',  name: 'Lista com marcadores', desc: 'Itens com •', syntax: '- ', cursor: 2 },
    { group: 'Lista', icon: '1.', name: 'Lista numerada', desc: 'Itens numerados', syntax: '1. ', cursor: 3 },
    { group: 'Mídia', icon: '📹', name: 'Vídeo YouTube/Vimeo', desc: 'Embed de vídeo', syntax: ':::video https://youtube.com/watch?v=ID :::\n', cursor: 9, special: 'video' },
    { group: 'Mídia', icon: '🛒', name: 'Card de Produto', desc: 'Produto da Webriders', syntax: ':::produto https://webriders.com.br/produto :::\n', cursor: 10, special: 'product' },
    { group: 'Avançado', icon: '⊞', name: 'Tabela', desc: '3 colunas de exemplo', syntax: '| Coluna 1 | Coluna 2 | Coluna 3 |\n|---|---|---|\n| Dado | Dado | Dado |\n', cursor: 0 },
    { group: 'Avançado', icon: '</>', name: 'Código', desc: 'Bloco de código', syntax: '```\n\n```\n', cursor: 4 },
    { group: 'Avançado', icon: '`', name: 'Código inline', desc: 'Trecho de código', syntax: '``', cursor: 1 },
    { group: 'Avançado', icon: '**', name: 'Negrito', desc: 'Texto em negrito', syntax: '**texto**', cursor: 2 },
    { group: 'Avançado', icon: '_', name: 'Itálico', desc: 'Texto em itálico', syntax: '_texto_', cursor: 1 },
];

// ── Renderização do menu ──────────────────────────────────────
function buildSlashMenu(filter = '') {
    const container = document.getElementById('slash-items-container');
    container.innerHTML = '';
    highlightIdx = 0;
    visibleItems = [];

    const filtered = SLASH_COMMANDS.filter(c =>
        c.name.toLowerCase().includes(filter.toLowerCase()) ||
        c.group.toLowerCase().includes(filter.toLowerCase())
    );

    const groups = [...new Set(filtered.map(c => c.group))];
    groups.forEach(group => {
        const section = document.createElement('div');
        section.className = 'slash-menu-section';
        section.textContent = group;
        container.appendChild(section);

        filtered.filter(c => c.group === group).forEach((cmd, i) => {
            const item = document.createElement('div');
            item.className = 'slash-item' + (visibleItems.length === 0 ? ' highlighted' : '');
            item.innerHTML = `
                <div class="slash-item-icon">${cmd.icon}</div>
                <div class="slash-item-text">
                    <div class="slash-item-name">${cmd.name}</div>
                    <div class="slash-item-desc">${cmd.desc}</div>
                </div>`;
            item.addEventListener('mousedown', (e) => {
                e.preventDefault();
                insertSlashCommand(cmd);
            });
            container.appendChild(item);
            visibleItems.push({ el: item, cmd });
        });
    });
}

function highlightSlashItem(idx) {
    visibleItems.forEach((v, i) => {
        v.el.classList.toggle('highlighted', i === idx);
        if (i === idx) v.el.scrollIntoView({ block: 'nearest' });
    });
}

// ── Abrir / fechar slash menu ─────────────────────────────────
// ── Abrir / fechar slash menu ─────────────────────────────────
function openSlashMenu() {
    buildSlashMenu('');
    slashSearch.value = '';
    slashMenu.classList.add('open');
    positionSlashMenu();
}

function closeSlashMenu() {
    slashMenu.classList.remove('open');
    slashStart = -1;
}

function positionSlashMenu() {
    const caret  = getCaretCoords(textarea, textarea.selectionStart);
    const taRect = textarea.getBoundingClientRect();

    const MENU_W   = 260;
    const MARGIN   = 8;
    const caretTop  = taRect.top  + caret.top  - textarea.scrollTop;
    const caretLeft = taRect.left + caret.left;

    const spaceBelow = window.innerHeight - caretTop - 24;
    const spaceAbove = caretTop;

    let top, maxH;
    if (spaceBelow >= 160 || spaceBelow >= spaceAbove) {
        top  = caretTop + 22;
        maxH = Math.min(420, spaceBelow - MARGIN);
    } else {
        maxH = Math.min(420, spaceAbove - MARGIN);
        top  = caretTop - maxH - 4;
    }

    let left = caretLeft;
    if (left + MENU_W + MARGIN > window.innerWidth) left = window.innerWidth - MENU_W - MARGIN;
    if (left < MARGIN) left = MARGIN;

    slashMenu.style.top       = top  + 'px';
    slashMenu.style.left      = left + 'px';
    slashMenu.style.maxHeight = maxH + 'px';
}

// ── Inserir comando ───────────────────────────────────────────
function insertSlashCommand(cmd) {
    const pos     = textarea.selectionStart;
    const text    = textarea.value;
    const before  = text.substring(0, slashStart >= 0 ? slashStart : pos - 1);
    const after   = text.substring(pos);

    let syntax = cmd.syntax;

    // Para produto e vídeo abrimos um prompt rápido
    if (cmd.special === 'product') {
        const url = prompt('URL do produto Webriders:', 'https://webriders.com.br/');
        if (!url) { closeSlashMenu(); textarea.focus(); return; }
        syntax = `:::produto ${url.trim()} :::\n`;
    } else if (cmd.special === 'video') {
        const url = prompt('URL do vídeo (YouTube ou Vimeo):', 'https://www.youtube.com/watch?v=');
        if (!url) { closeSlashMenu(); textarea.focus(); return; }
        syntax = `:::video ${url.trim()} :::\n`;
    }

    textarea.value = before + syntax + after;
    const newPos = before.length + (cmd.special ? syntax.length : cmd.cursor);
    textarea.selectionStart = textarea.selectionEnd = newPos;
    closeSlashMenu();
    textarea.focus();
    updatePreview();
    updateWordCount();
}

// ── Keydown no textarea ───────────────────────────────────────
textarea.addEventListener('keydown', (e) => {
    if (slashMenu.classList.contains('open')) {
        if (e.key === 'ArrowDown') {
            e.preventDefault();
            highlightIdx = Math.min(highlightIdx + 1, visibleItems.length - 1);
            highlightSlashItem(highlightIdx);
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            highlightIdx = Math.max(highlightIdx - 1, 0);
            highlightSlashItem(highlightIdx);
        } else if (e.key === 'Enter') {
            e.preventDefault();
            if (visibleItems[highlightIdx]) insertSlashCommand(visibleItems[highlightIdx].cmd);
        } else if (e.key === 'Escape') {
            closeSlashMenu();
        }
    }

    // Tab para indent em código
    if (e.key === 'Tab') {
        e.preventDefault();
        const s = textarea.selectionStart;
        const v = textarea.value;
        textarea.value = v.substring(0, s) + '    ' + v.substring(s);
        textarea.selectionStart = textarea.selectionEnd = s + 4;
    }
});

// ── Input no textarea ─────────────────────────────────────────
textarea.addEventListener('input', (e) => {
    updatePreview();
    updateWordCount();

    const pos  = textarea.selectionStart;
    const text = textarea.value;
    const char = text.charAt(pos - 1);

    if (char === '/') {
        slashStart = pos - 1;
        openSlashMenu();
    } else if (slashMenu.classList.contains('open')) {
        // filtrar enquanto digita após /
        if (slashStart >= 0) {
            const query = text.substring(slashStart + 1, pos);
            if (/[\s\n]/.test(query)) {
                closeSlashMenu();
            } else {
                slashSearch.value = query;
                buildSlashMenu(query);
                positionSlashMenu();
            }
        }
    }
});

// ── Busca dentro do menu slash ────────────────────────────────
slashSearch.addEventListener('input', () => {
    buildSlashMenu(slashSearch.value);
    highlightIdx = 0;
    highlightSlashItem(0);
});
slashSearch.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); highlightIdx = Math.min(highlightIdx + 1, visibleItems.length - 1); highlightSlashItem(highlightIdx); }
    if (e.key === 'ArrowUp')   { e.preventDefault(); highlightIdx = Math.max(highlightIdx - 1, 0); highlightSlashItem(highlightIdx); }
    if (e.key === 'Enter')     { e.preventDefault(); if (visibleItems[highlightIdx]) insertSlashCommand(visibleItems[highlightIdx].cmd); }
    if (e.key === 'Escape')    { closeSlashMenu(); textarea.focus(); }
});

document.addEventListener('mousedown', (e) => {
    if (!slashMenu.contains(e.target) && e.target !== textarea) closeSlashMenu();
});

// ── Paste inteligente (link Webriders → produto) ──────────────
textarea.addEventListener('paste', (e) => {
    const pasted = (e.clipboardData || window.clipboardData).getData('text');
    if (pasted && pasted.includes('webriders.com.br/')) {
        e.preventDefault();
        const s = textarea.selectionStart;
        const v = textarea.value;
        const block = `\n:::produto ${pasted.trim()} :::\n`;
        textarea.value = v.substring(0, s) + block + v.substring(s);
        textarea.selectionStart = textarea.selectionEnd = s + block.length;
        updatePreview();
    }
});

// ── Preview ao vivo ───────────────────────────────────────────
function updatePreview() {
    let md = textarea.value;

    // 1. Processar :::produto:::
    md = md.replace(/:::produto\s+(https?:\/\/[^\s]+)\s+:::/g, (match, url) => {
        const u = url.trim();
        if (productCache[u]) {
            const p = productCache[u];
            const variants = (p.variations || []).map(v => `<span class="product-variant-badge">${v}</span>`).join('');
            return `<div class="product-block-card">
                        <img src="${p.image || ''}" class="product-block-img" onerror="this.style.display='none'" />
                        <div class="product-block-info">
                            <div>
                                <div class="product-block-title">${p.title || ''}</div>
                                <div class="product-block-price">${p.price || ''}</div>
                                <div class="product-block-variants">${variants}</div>
                            </div>
                            <a href="${p.url || u}" target="_blank" class="product-block-btn">Ver na Loja →</a>
                        </div>
                    </div>`;
        } else {
            fetchProduct(u);
            return `<div class="product-block-card" style="border-style:dashed;border-color:#333;justify-content:center;align-items:center;height:90px;color:#555;font-size:13px;text-align:center;">
                        🔄 Buscando produto Webriders...
                    </div>`;
        }
    });

    // 2. Processar :::video:::
    md = md.replace(/:::video\s+(https?:\/\/[^\s]+)\s+:::/g, (match, url) => {
        const embedUrl = convertToEmbedUrl(url.trim());
        if (!embedUrl) return `<p style="color:#ff3c00;">⚠️ URL de vídeo inválida</p>`;
        return `<div class="video-embed-block"><iframe src="${embedUrl}" allowfullscreen loading="lazy"></iframe></div>`;
    });

    previewArea.innerHTML = marked.parse(md);
}

function convertToEmbedUrl(url) {
    // YouTube
    let m = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([A-Za-z0-9_-]{11})/);
    if (m) return `https://www.youtube.com/embed/${m[1]}`;
    // Vimeo
    m = url.match(/vimeo\.com\/(\d+)/);
    if (m) return `https://player.vimeo.com/video/${m[1]}`;
    return null;
}

// ── Fetch produto assíncrono ──────────────────────────────────
async function fetchProduct(url) {
    if (productCache[url] !== undefined) return;
    productCache[url] = null; // marca como em fetch
    try {
        const res  = await fetch(`/admin/scrape-product?url=${encodeURIComponent(url)}`);
        const data = await res.json();
        productCache[url] = res.ok ? data : { title: 'Produto indisponível', price: 'R$ --', variations: [], image: '', url };
    } catch {
        productCache[url] = { title: 'Erro ao carregar produto', price: 'R$ --', variations: [], image: '', url };
    }
    updatePreview();
}

// ── Contagem de palavras + barra "throttle" (progresso de leitura) ────
function updateWordCount() {
    const words = textarea.value.trim().split(/\s+/).filter(Boolean).length;
    document.getElementById('word-count').textContent = `${words} palavra${words !== 1 ? 's' : ''}`;

    const readingMin = Math.max(1, Math.round(words / 200));
    const targetMin  = parseInt(document.getElementById('reading-time-input')?.value) || 5;
    const pct = Math.min(100, Math.round((readingMin / targetMin) * 100));

    const fill = document.getElementById('throttle-fill');
    if (fill) fill.style.width = pct + '%';

    const wordsLabel = document.getElementById('throttle-words');
    const timeLabel  = document.getElementById('throttle-time');
    if (wordsLabel) wordsLabel.textContent = `${words} palavra${words !== 1 ? 's' : ''}`;
    if (timeLabel)  timeLabel.textContent  = `leitura ~${readingMin}min de ${targetMin}min alvo`;
}

// ── Atualiza a pílula de status ao trocar o select ─────────────
document.getElementById('status-select')?.addEventListener('change', (e) => {
    const pill = document.getElementById('status-pill');
    if (!pill) return;
    const published = e.target.value === 'Published';
    pill.classList.toggle('published', published);
    pill.classList.toggle('draft', !published);
    pill.textContent = published ? 'Publicado' : 'Rascunho';
});

document.getElementById('reading-time-input')?.addEventListener('input', updateWordCount);

// ── Modos do editor (split / editor / preview) ────────────────
function setEditorMode(mode) {
    const split = document.getElementById('editor-split');
    split.className = 'editor-split mode-' + mode;
    ['split','editor','preview'].forEach(m => {
        document.getElementById('tab-' + m).classList.toggle('active', m === mode);
    });
}

// ── Toggle Destaque ───────────────────────────────────────────
function toggleFeatured() {
    const row   = document.getElementById('featured-toggle');
    const input = document.getElementById('is-featured-input');
    const active = row.classList.toggle('is-active');
    input.value = active ? 'true' : 'false';
}

// Inicializa valor do input hidden com o estado do model
(function initFeatured() {
    const row   = document.getElementById('featured-toggle');
    const input = document.getElementById('is-featured-input');
    input.value = row.classList.contains('is-active') ? 'true' : 'false';
})();

// ── Tabs de capa (upload / url) ───────────────────────────────
function switchCoverTab(tab) {
    ['upload','url'].forEach(t => {
        document.getElementById('cover-tab-'   + t).classList.toggle('active', t === tab);
        document.getElementById('cover-panel-' + t).classList.toggle('active', t === tab);
    });
}

// ── Aplicar URL da imagem ─────────────────────────────────────
function applyCoverUrl() {
    const url = document.getElementById('cover-url-input').value.trim();
    if (!url) return;
    setCoverImage(url);
}

function setCoverImage(url) {
    document.getElementById('featured-image-input').value = url;
    const box = document.getElementById('cover-preview-box');
    box.innerHTML = `<img id="cover-img" src="${url}" style="width:100%;height:100%;object-fit:cover;" onerror="onCoverError()" />`;
}

function onCoverError() {
    document.getElementById('cover-preview-box').innerHTML =
        `<div class="cover-placeholder"><span>⚠️</span>Imagem não encontrada</div>`;
}

// ── Upload de imagem ──────────────────────────────────────────
const antiToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

document.getElementById('img-file-input')?.addEventListener('change', async (e) => {
    const file   = e.target.files?.[0];
    const status = document.getElementById('upload-status');
    if (!file) return;

    status.textContent = '⏳ Enviando...';
    const fd = new FormData();
    fd.append('file', file);
    if (antiToken) fd.append('__RequestVerificationToken', antiToken);

    try {
        const res  = await fetch('/admin/media/upload', { method: 'POST', body: fd });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Falha no upload');
        setCoverImage(data.url);
        status.textContent = '✓ Upload concluído';
        setTimeout(() => status.textContent = '', 3000);
    } catch (err) {
        status.textContent = '✗ ' + err.message;
    }
});

// ── Coordenadas do caret (para posicionamento do menu) ────────
function getCaretCoords(el, pos) {
    const div = document.createElement('div');
    const cs  = window.getComputedStyle(el);
    ['fontFamily','fontSize','fontWeight','lineHeight','letterSpacing',
     'paddingTop','paddingRight','paddingBottom','paddingLeft',
     'borderTopWidth','borderRightWidth','borderBottomWidth','borderLeftWidth',
     'boxSizing','whiteSpace','wordBreak','overflowWrap','width'].forEach(p => div.style[p] = cs[p]);
    div.style.position   = 'absolute';
    div.style.visibility = 'hidden';
    div.style.overflow   = 'hidden';
    div.style.whiteSpace = 'pre-wrap';
    div.style.height     = 'auto';
    div.textContent = el.value.substring(0, pos);
    const span = document.createElement('span');
    span.textContent = '.';
    div.appendChild(span);
    document.body.appendChild(div);
    const coords = { top: span.offsetTop, left: span.offsetLeft };
    document.body.removeChild(div);
    return coords;
}

// ── Init ──────────────────────────────────────────────────────
updatePreview();
updateWordCount();
</script>
}
