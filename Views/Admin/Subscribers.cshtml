@model List<ThrottleBlog.Models.NewsletterSubscriber>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Inscritos na Newsletter";
    var query = ViewBag.SearchQuery as string ?? "";
}

<div class="posts-toolbar">
    <form method="get" asp-controller="Admin" asp-action="Subscribers" style="display:flex; gap:10px; flex:1;">
        <input type="text" name="q" value="@query" placeholder="Pesquisar por nome ou e-mail..." class="search-input" />
        <button type="submit" class="btn-primary">Buscar</button>
        @if (!string.IsNullOrEmpty(query))
        {
            <a asp-controller="Admin" asp-action="Subscribers" class="btn-secondary">Limpar</a>
        }
    </form>
</div>

<div class="panel">
    <div class="panel-header">
        <div class="panel-title">Lista de Inscritos (@Model.Count)</div>
    </div>
    
    <div class="table-wrap">
        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon">✉</div>
                <div class="empty-state-title">Nenhum inscrito encontrado</div>
                <p>Nenhum contato cadastrado no momento ou a busca não retornou resultados.</p>
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>E-mail</th>
                        <th>Data de Inscrição</th>
                        <th>Plano</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td style="font-weight:600;">@s.Name</td>
                            <td style="color:var(--text); font-family:monospace;">@s.Email</td>
                            <td style="color:var(--muted);">@s.SubscribedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <span class="plan-badge @(s.Tier == ThrottleBlog.Models.NewsletterTier.Premium ? "plan-premium" : "plan-free")">
                                    @(s.Tier == ThrottleBlog.Models.NewsletterTier.Premium ? "Premium" : "Comum")
                                </span>
                            </td>
                            <td>
                                <span class="status-badge @(s.IsActive ? "status-active" : "status-inactive")">
                                    @(s.IsActive ? "Ativo" : "Inativo")
                                </span>
                            </td>
                            <td>
                                <div class="table-actions">
                                    <!-- Form Status Toggle -->
                                    <form asp-controller="Admin" asp-action="ToggleSubscriberStatus" asp-route-id="@s.Id" method="post" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="tbl-btn" title="Ativar ou Inativar inscrição">
                                            Status
                                        </button>
                                    </form>

                                    <!-- Form Plan Toggle -->
                                    <form asp-controller="Admin" asp-action="ToggleSubscriberPlan" asp-route-id="@s.Id" method="post" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="tbl-btn" title="Alterar plano">
                                            Alterar Plano
                                        </button>
                                    </form>

                                    <!-- Form Delete -->
                                    <form asp-controller="Admin" asp-action="DeleteSubscriber" asp-route-id="@s.Id" method="post" style="margin:0;" onsubmit="return confirm('Deseja realmente excluir este inscrito da newsletter?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="tbl-btn del" title="Remover permanentemente">
                                            Excluir
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@section Styles {
    <style>
      
    </style>
}
