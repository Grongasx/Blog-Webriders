@model ThrottleBlog.ViewModels.LoginViewModel
@{
    Layout = null; // página standalone sem sidebar
    ViewData["Title"] = "Entrar — Webriders Admin";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;900&family=Barlow:wght@400;500;600&family=Bebas+Neue&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true">
</head>
<body class="login-body">

    <div class="login-card">
        <div class="login-brand">
            <div class="login-logo-icon">⬡</div>
            <div class="login-brand-name">Webriders<span>.</span></div>
            <div class="login-brand-sub">Painel Administrativo</div>
        </div>

        <form asp-controller="Auth" asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl">

            <div asp-validation-summary="ModelOnly" class="form-error"></div>

            <div class="form-group">
                <label class="form-label">Usuário</label>
                <input class="form-input" asp-for="UserName" autocomplete="username" autofocus>
                <span asp-validation-for="UserName" class="field-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Senha</label>
                <input class="form-input" asp-for="Password" type="password" autocomplete="current-password">
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="login-remember">
                <label>
                    <input type="checkbox" asp-for="RememberMe"> Manter conectado
                </label>
            </div>

            <button type="submit" class="btn-primary btn-block">Entrar →</button>
        </form>
    </div>

</body>
</html>
