@model ThrottleBlog.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Entrar — Webriders Admin";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;900&family=Barlow:wght@400;500;600&family=Bebas+Neue&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --red: #e81a1a;
            --red-glow: rgba(232, 26, 26, 0.25);
            --black: #0a0a0a;
            --dark: #111111;
            --card: #181818;
            --border: rgba(255, 255, 255, 0.07);
            --border-focus: rgba(232, 26, 26, 0.5);
            --text: #e0e0e0;
            --muted: #777;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body.login-body {
            background-color: var(--black);
            background-image: radial-gradient(circle at 50% 50%, #1a0505 0%, var(--black) 70%);
            font-family: 'Barlow', sans-serif;
            color: var(--text);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            overflow: hidden;
        }

        .login-card {
            background: var(--card);
            border: 1px solid var(--border);
            padding: 40px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
            position: relative;
            animation: cardReveal 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }

        /* Detalhe estético da linha vermelha superior de corrida */
        .login-card::before {
            content: '';
            position: absolute;
            top: -1px;
            left: -1px;
            right: -1px;
            height: 3px;
            background: var(--red);
            box-shadow: 0 2px 10px var(--red);
        }

        .login-brand {
            text-align: center;
            margin-bottom: 35px;
        }

        .login-logo-icon {
            font-size: 32px;
            color: var(--red);
            text-shadow: 0 0 10px var(--red-glow);
            margin-bottom: 8px;
            animation: pulseGlow 2s infinite ease-in-out;
        }

        .login-brand-name {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 36px;
            letter-spacing: 1px;
            line-height: 1;
            color: #fff;
        }

        .login-brand-name span {
            color: var(--red);
        }

        .login-brand-sub {
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 3px;
            color: var(--muted);
            margin-top: 5px;
        }

        .form-group {
            margin-bottom: 22px;
        }

        .form-label {
            display: block;
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--muted);
            margin-bottom: 8px;
        }

        .form-input {
            width: 100%;
            background: var(--dark);
            border: 1px solid var(--border);
            padding: 12px 16px;
            color: #fff;
            font-family: 'Barlow', sans-serif;
            font-size: 14px;
            transition: all 0.25s ease;
        }

        .form-input:focus {
            outline: none;
            border-color: var(--red);
            box-shadow: 0 0 12px var(--red-glow);
            background: #141414;
        }

        .login-remember {
            margin: 20px 0 25px 0;
            display: flex;
            align-items: center;
        }

        .login-remember label {
            font-size: 13px;
            color: var(--text);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            user-select: none;
        }

        .login-remember input[type="checkbox"] {
            accent-color: var(--red);
            width: 15px;
            height: 15px;
            cursor: pointer;
        }

        .btn-primary {
            width: 100%;
            background: var(--red);
            color: #fff;
            border: none;
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 900;
            font-size: 15px;
            text-transform: uppercase;
            letter-spacing: 2px;
            padding: 14px;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-primary:hover {
            background: #ff2424;
            box-shadow: 0 0 20px rgba(232, 26, 26, 0.4);
            transform: translateY(-1px);
        }

        .btn-primary:active {
            transform: translateY(1px);
        }

        /* Erros de Validação customizados no tema */
        .form-error, .field-error {
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            font-size: 12px;
            color: var(--red);
            letter-spacing: 0.5px;
            margin-top: 5px;
            list-style: none;
        }
        
        .form-error {
            background: rgba(232, 26, 26, 0.1);
            border-left: 3px solid var(--red);
            padding: 10px;
            margin-bottom: 20px;
        }

        /* Animações mecânicas */
        @@keyframes cardReveal {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@keyframes pulseGlow {
            0%, 100% { transform: scale(1); opacity: 0.9; }
            50% { transform: scale(1.05); opacity: 1; text-shadow: 0 0 15px var(--red); }
        }
    </style>
</head>
<body class="login-body">

    <div class="login-card">
        <div class="login-brand">
            <div class="login-logo-icon">⬡</div>
            <div class="login-brand-name">Webriders<span>.</span></div>
            <div class="login-brand-sub">Painel Administrativo</div>
        </div>

        <form asp-controller="Auth" asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl">

            <div asp-validation-summary="ModelOnly" class="form-error"></div>

            <div class="form-group">
                <label class="form-label">Usuário</label>
                <input class="form-input" asp-for="UserName" autocomplete="username" autofocus>
                <span asp-validation-for="UserName" class="field-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Senha</label>
                <input class="form-input" asp-for="Password" type="password" autocomplete="current-password">
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="login-remember">
                <label>
                    <input type="checkbox" asp-for="RememberMe"> Manter conectado
                </label>
            </div>

            <button type="submit" class="btn-primary">Entrar →</button>
        </form>
    </div>

</body>
</html>