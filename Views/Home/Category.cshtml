@model ThrottleBlog.ViewModels.CategoryViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.Category.Name;
}

@* ── HERO DA CATEGORIA ── *@
<section class="hero-section" style="min-height:260px">
    <div class="container" style="padding-top:3rem;padding-bottom:2rem">
        <div class="fade-up" style="display:flex;flex-direction:column;gap:.5rem">
            <div class="section-label">
                <a asp-controller="Home" asp-action="Index"
                   style="color:var(--muted);text-decoration:none">Home</a>
                <span style="color:var(--muted)"> / </span>
                Categorias
            </div>
            <h1 style="font-size:clamp(2rem,5vw,3.5rem);font-weight:900;
                        color:var(--white);line-height:1.1;margin:0">
                @Model.Category.Name
            </h1>
            <p style="color:var(--muted);font-size:.95rem;margin:0">
                @Model.Pagination.TotalItems
                artigo@(Model.Pagination.TotalItems != 1 ? "s" : "")
                encontrado@(Model.Pagination.TotalItems != 1 ? "s" : "")
            </p>
        </div>
    </div>
</section>

@* ── POSTS DA CATEGORIA ── *@
<section>
    <div class="container">

        @if (!Model.Posts.Any())
        {
            <div class="fade-up" style="text-align:center;padding:4rem 0;color:var(--muted)">
                <p style="font-size:1.1rem">Nenhum post publicado nesta categoria ainda.</p>
                <a asp-controller="Home" asp-action="Index"
                   class="btn-primary"
                   style="margin-top:1rem;display:inline-flex">
                    ← Voltar para Home
                </a>
            </div>
        }
        else
        {
            <div class="posts-grid fade-up">
                @foreach (var p in Model.Posts)
                {
                    <a asp-controller="Post" asp-action="Detail"
                       asp-route-slug="@p.Slug"
                       class="article-card">
                        <div class="article-img-wrap">
                            @if (!string.IsNullOrEmpty(p.FeaturedImage))
                            {
                                <img class="article-img" src="@p.FeaturedImage" alt="@p.Title">
                            }
                            <span class="article-cat">@p.Category?.Name</span>
                        </div>
                        <div class="article-body">
                            <h3 class="article-title">@p.Title</h3>
                            <p class="article-excerpt">@p.Excerpt</p>
                            <div class="article-meta">
                                <span>@p.Author?.DisplayName</span>
                                <span class="sep">·</span>
                                <span>@p.PublishedAt?.ToString("dd MMM yyyy")</span>
                                <span class="article-read-time">@p.ReadingTime min</span>
                            </div>
                        </div>
                    </a>
                }
            </div>

            @* ── PAGINAÇÃO ── *@
            @if (Model.Pagination.TotalPages > 1)
            {
                <nav class="fade-up" aria-label="Paginação"
                     style="display:flex;justify-content:center;align-items:center;
                            gap:.5rem;padding:2.5rem 0 1rem">

                    @if (Model.Pagination.HasPrev)
                    {
                        <a asp-controller="Home" asp-action="Category"
                           asp-route-slug="@Model.Category.Slug"
                           asp-route-page="@(Model.Pagination.CurrentPage - 1)"
                           class="btn-primary"
                           style="padding:.5rem 1rem;font-size:.85rem">
                            ← Anterior
                        </a>
                    }

                    @for (var i = 1; i <= Model.Pagination.TotalPages; i++)
                    {
                        var active = i == Model.Pagination.CurrentPage;
                        <a asp-controller="Home" asp-action="Category"
                           asp-route-slug="@Model.Category.Slug"
                           asp-route-page="@i"
                           aria-current="@(active ? "page" : null)"
                           style="display:inline-flex;align-items:center;justify-content:center;
                                  width:2.2rem;height:2.2rem;font-size:.85rem;font-weight:700;
                                  text-decoration:none;
                                  border:1px solid @(active ? "var(--red)" : "var(--border)");
                                  background:@(active ? "var(--red)" : "transparent");
                                  color:@(active ? "var(--white)" : "var(--muted)")">
                            @i
                        </a>
                    }

                    @if (Model.Pagination.HasNext)
                    {
                        <a asp-controller="Home" asp-action="Category"
                           asp-route-slug="@Model.Category.Slug"
                           asp-route-page="@(Model.Pagination.CurrentPage + 1)"
                           class="btn-primary"
                           style="padding:.5rem 1rem;font-size:.85rem">
                            Próxima →
                        </a>
                    }
                </nav>
            }
        }

    </div>
</section>

@* ── NEWSLETTER ── *@
@if (Model.Settings?.NewsletterEnabled == true)
{
    <section class="newsletter-section" id="newsletter">
        <div class="container">
            <div class="newsletter-inner fade-up">
                <div>
                    <span class="newsletter-tag">Newsletter</span>
                    <h2 class="newsletter-title">Acelere<br>seu feed</h2>
                    <p class="newsletter-desc">Receba toda semana as melhores matérias direto no seu e-mail.</p>
                </div>
                <form asp-controller="Home" asp-action="Newsletter" method="post"
                      class="newsletter-form newsletter-form-ajax"
                      data-message-id="newsletter-message">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnTo" value="Index">
                    <input class="form-input" type="text"  name="Name"  placeholder="Seu nome" required>
                    <input class="form-input" type="email" name="Email" placeholder="Seu melhor e-mail" required>
                    <button type="submit" class="btn-primary"
                            style="width:100%;justify-content:center">
                        ▶ Quero Receber Gratuitamente
                    </button>
                    <div id="newsletter-message" class="newsletter-message" role="status"></div>
                    <p style="font-size:11px;color:var(--muted);text-align:center">
                        Sem spam.
                        <a asp-controller="Home" asp-action="NewsletterPage"
                           asp-fragment="premium"
                           style="color:var(--red)">Conheça o plano Premium →</a>
                    </p>
                </form>
            </div>
        </div>
    </section>
}
