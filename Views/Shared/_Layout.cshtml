@using ThrottleBlog.Models
@inject ThrottleBlog.Services.ISettingsService  SettingsService
@inject ThrottleBlog.Services.ICategoryService  CategoryService
@{
    var settings   = await SettingsService.GetAsync();
    var allCats    = await CategoryService.GetAllAsync();
    var navCats    = allCats.OrderBy(c => c.SortOrder).Take(5).ToList();
    var footerCats = allCats.OrderBy(c => c.SortOrder).ToList();
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — " : "")@settings.BlogName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,400;0,700;0,900;1,900&family=Barlow:wght@400;500;600&family=Bebas+Neue&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <script src="~/lib/turbo/dist/turbo.es2017-esm.js" asp-append-version="true" type="module"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    @* ── LOADING OVERLAY (Turbo Drive) ── *@
    <div id="loading-overlay" class="loading-hidden">
        <div class="loading-content">
            <div id="motorcycle-loader" class="motorcycle-wrap">
                <img src="~/images/moto.svg" alt="Carregando..." class="moto-img">
            </div>
            <div class="loading-bar-wrap">
                <div id="progress-bar"></div>
            </div>
        </div>
    </div>

    @if (settings.TickerEnabled)
    {
        <div class="topbar">@settings.TopBarText</div>
    }

    <nav>
        <div class="nav-inner">
        <a class="nav-logo" asp-controller="Home" asp-action="Index">
            <div class="logo-icon">⬡</div>
            @settings.BlogName<span>.</span>
        </a>

        <button class="nav-toggle" id="nav-toggle" type="button"
                aria-label="Abrir menu" aria-expanded="false" aria-controls="nav-collapse">
            <span></span><span></span><span></span>
        </button>

        <div class="nav-collapse" id="nav-collapse">
            <ul class="nav-links">
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                @foreach (var cat in navCats)
                {
                    @* Aponta para o CategoryController dinâmico — funciona para qualquer slug *@
                    <li>
                        <a href="/@cat.Slug">@cat.Name</a>
                    </li>
                }
            </ul>
            <form class="nav-search" asp-controller="Home" asp-action="Search" method="get">
                <input type="search" name="q" placeholder="Buscar…" aria-label="Buscar posts" required>
                <button type="submit" aria-label="Buscar">🔍</button>
            </form>
            <a class="nav-cta" asp-controller="Home" asp-action="NewsletterPage">Newsletter</a>
        </div>
        </div>
    </nav>

    <main>
        @if (TempData["NewsletterSuccess"] is string okMsg)
        {
            <div class="flash flash-success">@okMsg</div>
        }
        @if (TempData["NewsletterError"] is string errMsg)
        {
            <div class="flash flash-error">@errMsg</div>
        }
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <div class="footer-grid">
                @* Lado Esquerdo: Marca e Social *@
                <div>
                    <div class="footer-brand-title">@settings.BlogName<span>.</span></div>
                    <p class="footer-desc">@settings.Tagline</p>
                    <div class="social-links">
                        @if (!string.IsNullOrEmpty(settings.Twitter))   { <a class="social-link" href="@settings.Twitter"   target="_blank">𝕏</a> }
                        @if (!string.IsNullOrEmpty(settings.LinkedIn))  { <a class="social-link" href="@settings.LinkedIn"  target="_blank">in</a> }
                        @if (!string.IsNullOrEmpty(settings.YouTube))   { <a class="social-link" href="@settings.YouTube"   target="_blank">▶</a> }
                        @if (!string.IsNullOrEmpty(settings.Instagram)) { <a class="social-link" href="@settings.Instagram" target="_blank">◉</a> }
                    </div>
                </div>

                @* Lado Direito: categorias dinâmicas no footer também *@
                <div>
                    <div class="footer-nav-title">Explorar</div>
                    <ul class="footer-nav-list">
                        @foreach (var cat in footerCats)
                        {
                            <li><a href="/@cat.Slug">@cat.Name</a></li>
                        }
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>© @DateTime.Now.Year @settings.BlogName — Feito com <span>♥</span> para motociclistas</p>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
    (function () {
        'use strict';
    
        const THRESHOLD = 50; // px mínimos para confirmar um swipe
    
        function initCarousel(root) {
            const track   = root.querySelector('.pc-track');
            const dots    = root.querySelectorAll('.pc-dot');
            const counter = root.querySelector('.pc-current');
            const prevBtn = root.querySelector('.pc-prev');
            const nextBtn = root.querySelector('.pc-next');
            const slides  = root.querySelectorAll('.pc-slide');
            const total   = slides.length;
    
            if (!track || total < 2) return;
    
            let current   = 0;
            let startX    = 0;
            let startY    = 0;
            let isDragging = false;
            let dragDelta  = 0;
    
            // ── Navega para o índice indicado ──
            function goTo(idx) {
                current = Math.max(0, Math.min(idx, total - 1));
                track.style.transform = `translateX(-${current * 100}%)`;
    
                slides.forEach((s, i) =>
                    s.setAttribute('aria-hidden', i === current ? 'false' : 'true'));
    
                dots.forEach((d, i) => {
                    d.classList.toggle('active', i === current);
                    d.setAttribute('aria-selected', i === current ? 'true' : 'false');
                });
    
                if (counter) counter.textContent = current + 1;
    
                if (prevBtn) prevBtn.disabled = current === 0;
                if (nextBtn) nextBtn.disabled = current === total - 1;
            }
    
            // ── Setas ──
            prevBtn?.addEventListener('click', () => goTo(current - 1));
            nextBtn?.addEventListener('click', () => goTo(current + 1));
    
            // ── Dots ──
            dots.forEach(dot =>
                dot.addEventListener('click', () => goTo(parseInt(dot.dataset.index))));
    
            // ── Touch / swipe ──
            track.addEventListener('touchstart', e => {
                startX = e.touches[0].clientX;
                startY = e.touches[0].clientY;
                isDragging = true;
                dragDelta = 0;
            }, { passive: true });
    
            track.addEventListener('touchmove', e => {
                if (!isDragging) return;
                dragDelta = e.touches[0].clientX - startX;
                const dy  = Math.abs(e.touches[0].clientY - startY);
    
                // Movimento mais vertical? deixa a página rolar, cancela swipe
                if (Math.abs(dragDelta) < dy) { isDragging = false; return; }
    
                track.style.transition = 'none';
                const pct = -(current * 100) + (dragDelta / root.offsetWidth * 100);
                track.style.transform  = `translateX(${pct}%)`;
            }, { passive: true });
    
            track.addEventListener('touchend', () => {
                if (!isDragging) return;
                isDragging = false;
                track.style.transition = '';
                if      (dragDelta < -THRESHOLD) goTo(current + 1);
                else if (dragDelta >  THRESHOLD) goTo(current - 1);
                else                             goTo(current);      // snap de volta
            });
    
            // ── Mouse drag (desktop) ──
            track.addEventListener('mousedown', e => {
                startX = e.clientX;
                isDragging = true;
                dragDelta = 0;
                track.style.cursor = 'grabbing';
            });
    
            window.addEventListener('mousemove', e => {
                if (!isDragging) return;
                dragDelta = e.clientX - startX;
                track.style.transition = 'none';
                const pct = -(current * 100) + (dragDelta / root.offsetWidth * 100);
                track.style.transform  = `translateX(${pct}%)`;
            });
    
            window.addEventListener('mouseup', () => {
                if (!isDragging) return;
                isDragging = false;
                track.style.cursor = '';
                track.style.transition = '';
                if      (dragDelta < -THRESHOLD) goTo(current + 1);
                else if (dragDelta >  THRESHOLD) goTo(current - 1);
                else                             goTo(current);
            });
    
            // ── Teclado ──
            root.setAttribute('tabindex', '0');
            root.addEventListener('keydown', e => {
                if (e.key === 'ArrowRight') goTo(current + 1);
                if (e.key === 'ArrowLeft')  goTo(current - 1);
            });
    
            // Estado inicial
            goTo(0);
        }
    
        // Inicializa todos os carrosséis da página
        document.querySelectorAll('.pc-carousel').forEach(initCarousel);
    })();
    </script>
</body>
</html>
