@model ThrottleBlog.ViewModels.NewsletterFormViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Newsletter";
}

<div class="newsletter-landing">
    <div class="landing-header">
        <span class="landing-tag">Newsletter</span>
        <h1 class="landing-title">Acelere seu feed de notícias</h1>
        <p class="landing-subtitle">Junte-se à maior comunidade de motociclismo do Brasil. Escolha o plano ideal para a sua jornada.</p>
    </div>

    @if (TempData["NewsletterError"] is string error)
    {
        <div class="container" style="margin-bottom: 20px;">
            <div class="flash flash-error" style="border-radius: 4px;">@error</div>
        </div>
    }

    <div class="plans-grid container">
        <!-- PLANO GRATUITO -->
        <div class="plan-card">
            <div class="plan-header">
                <h2 class="plan-name">Plano Gratuito</h2>
                <div class="plan-price">R$ 0<span>/mês</span></div>
                <p class="plan-desc">O essencial do blog diretamente no seu e-mail semanalmente.</p>
            </div>
            <div class="plan-divider"></div>
            <ul class="plan-features">
                <li><span>✓</span> Receba as últimas postagens e reviews</li>
                <li><span>✓</span> Dicas de segurança essenciais</li>
                <li><span>✓</span> Resumo de eventos de motociclismo</li>
                <li class="muted-feature">✗ Rotas exclusivas com mapa GPX</li>
                <li class="muted-feature">✗ Descontos com marcas parceiras</li>
                <li class="muted-feature">✗ Acesso ao grupo VIP no WhatsApp</li>
            </ul>
            <div class="plan-action">
                <form asp-controller="Newsletter" asp-action="InscreverGratis" method="post" class="landing-form">
                    @Html.AntiForgeryToken()
                    <input class="form-input" type="text" asp-for="Name" placeholder="Seu nome" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                    
                    <input class="form-input" type="email" asp-for="Email" placeholder="Seu melhor e-mail" required />
                    <span asp-validation-for="Email" class="text-danger"></span>

                    <button type="submit" class="btn-primary" style="width: 100%; margin-top: 10px;">
                        Inscrever-se Grátis
                    </button>
                </form>
            </div>
        </div>

        <!-- PLANO PREMIUM -->
        <div class="plan-card premium-card">
            <div class="premium-badge">MAIS POPULAR</div>
            <div class="plan-header">
                <h2 class="plan-name">Plano Premium 🏍️</h2>
                <div class="plan-price">R$ 9,90<span>/mês</span></div>
                <p class="plan-desc">Acesso total e exclusivo ao melhor conteúdo para entusiastas de duas rodas.</p>
            </div>
            <div class="plan-divider"></div>
            <ul class="plan-features">
                <li><span>✓</span> <strong>Tudo</strong> do plano gratuito</li>
                <li><span>✓</span> <strong>Rotas exclusivas</strong> com arquivos GPX para GPS</li>
                <li><span>✓</span> Acesso antecipado a reviews de motos e peças</li>
                <li><span>✓</span> <strong>Cupom de até 15%</strong> em marcas parceiras</li>
                <li><span>✓</span> Grupo VIP dos Webriders no WhatsApp</li>
                <li><span>✓</span> Experiência 100% livre de anúncios no blog</li>
            </ul>
            <div class="plan-action" style="margin-top: auto;">
                <a asp-controller="Newsletter" asp-action="Checkout" class="btn-primary premium-btn" style="width: 100%; display: block; text-align: center;">
                    Assinar Plano Premium
                </a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .newsletter-landing {
            padding: 80px 0;
            background: linear-gradient(180deg, var(--black) 0%, var(--dark) 100%);
            min-height: calc(100vh - 68px - 140px);
        }

        .landing-header {
            text-align: center;
            max-width: 700px;
            margin: 0 auto 60px;
            padding: 0 20px;
        }

        .landing-tag {
            display: inline-block;
            background: var(--red);
            color: var(--white);
            padding: 5px 12px;
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            font-size: 11px;
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: 16px;
        }

        .landing-title {
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 900;
            font-style: italic;
            font-size: clamp(32px, 5vw, 54px);
            text-transform: uppercase;
            line-height: 0.95;
            letter-spacing: -1px;
            margin-bottom: 18px;
        }

        .landing-subtitle {
            font-size: 16px;
            color: var(--muted);
            line-height: 1.6;
        }

        .plans-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 40px;
            max-width: 960px !important;
        }

        .plan-card {
            background: var(--card);
            border: 1px solid var(--border);
            padding: 48px;
            position: relative;
            display: flex;
            flex-direction: column;
            transition: transform 0.3s, border-color 0.3s;
            clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 20% 100%, 0 calc(100% - 20px));
        }

        .plan-card:hover {
            transform: translateY(-5px);
            border-color: rgba(255, 255, 255, 0.15);
        }

        .premium-card {
            border: 1px solid var(--red);
            background: linear-gradient(145deg, var(--card) 0%, rgba(232, 26, 26, 0.03) 100%);
            box-shadow: 0 10px 30px rgba(232, 26, 26, 0.05);
        }

        .premium-card:hover {
            border-color: #ff4d4d;
            box-shadow: 0 15px 40px var(--red-glow);
        }

        .premium-badge {
            position: absolute;
            top: 20px;
            right: 20px;
            background: var(--red);
            color: var(--white);
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            font-size: 11px;
            letter-spacing: 2px;
            padding: 4px 10px;
        }

        .plan-name {
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 900;
            font-style: italic;
            font-size: 28px;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .plan-price {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 54px;
            color: var(--white);
            line-height: 1;
            margin-bottom: 12px;
        }

        .plan-price span {
            font-size: 16px;
            color: var(--muted);
            font-family: 'Barlow', sans-serif;
            letter-spacing: 1px;
        }

        .plan-desc {
            font-size: 14px;
            color: var(--muted);
            line-height: 1.5;
            min-height: 45px;
        }

        .plan-divider {
            height: 1px;
            background: var(--border);
            margin: 24px 0;
        }

        .plan-features {
            list-style: none;
            padding: 0;
            margin: 0 0 40px 0;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .plan-features li {
            font-size: 14px;
            color: var(--text);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .plan-features li span {
            color: var(--red);
            font-weight: bold;
        }

        .plan-features li.muted-feature {
            color: #555;
        }

        .plan-features li.muted-feature span {
            color: #555;
        }

        .landing-form {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .premium-btn {
            background: var(--red) !important;
            padding: 18px 34px !important;
            font-size: 15px !important;
            text-shadow: 0 1px 2px rgba(0,0,0,0.5);
        }

        .premium-btn:hover {
            background: #ff3c00 !important;
        }

        @@media (max-width: 768px) {
            .plans-grid {
                grid-template-columns: 1fr;
                gap: 30px;
            }
            .plan-card {
                padding: 32px;
            }
        }
    </style>
}
