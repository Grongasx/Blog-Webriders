@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Inscrição Confirmada";
    var plan = ViewBag.Plan as string ?? "Gratuito";
    var email = ViewBag.Email as string ?? "";
}

<div class="success-page">
    <div class="success-card container">
        
        <!-- ÍCONE CHECK ANIMADO -->
        <div class="success-icon-wrapper">
            <div class="success-icon">
                <svg viewBox="0 0 52 52">
                    <circle class="success-circle" cx="26" cy="26" r="25" fill="none"/>
                    <path class="success-check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8"/>
                </svg>
            </div>
        </div>

        <span class="success-tag">Assinatura Ativada</span>
        <h1 class="success-title">Bem-vindo ao Webriders!</h1>
        <p class="success-subtitle">Inscrição concluída com sucesso no plano <strong class="plan-badge-highlight @(plan == "Premium" ? "badge-premium" : "badge-gratis")">@plan</strong>.</p>
        
        <div class="success-details">
            <p class="details-text">Enviamos uma confirmação e boas-vindas para o e-mail:</p>
            <div class="email-highlight">@email</div>
        </div>

        <!-- SEÇÕES ESPECÍFICAS POR PLANO -->
        @if (plan == "Premium")
        {
            <div class="premium-next-steps">
                <h3>⚡ Seus Superpoderes Premium já estão ativos:</h3>
                <ul>
                    <li>
                        <span class="step-icon">💬</span>
                        <div class="step-desc">
                            <strong>Grupo VIP no WhatsApp:</strong>
                            <p>Participe de conversas diárias com os editores e outros entusiastas. <a href="https://chat.whatsapp.com/mock-link-webriders" target="_blank" class="vip-link">Acessar Grupo VIP →</a></p>
                        </div>
                    </li>
                    <li>
                        <span class="step-icon">🗺️</span>
                        <div class="step-desc">
                            <strong>Downloads de Rotas GPX:</strong>
                            <p>Em breve no seu e-mail, as melhores rotas da região prontas para carregar no seu GPS.</p>
                        </div>
                    </li>
                    <li>
                        <span class="step-icon">🚫</span>
                        <div class="step-desc">
                            <strong>Navegação sem Anúncios:</strong>
                            <p>Faça login na sua conta do blog para ter a experiência limpa.</p>
                        </div>
                    </li>
                </ul>
            </div>
        }
        else
        {
            <div class="free-next-steps">
                <h3>📬 O que esperar a partir de agora:</h3>
                <p>Toda sexta-feira pela manhã, uma nova edição recheada de reviews honestos, notícias do motociclismo e muito mais chegará no seu e-mail. Não se esqueça de verificar a pasta de spam/promoções e favoritar nosso e-mail!</p>
            </div>
        }

        <div class="success-actions">
            <a asp-controller="Home" asp-action="Index" class="btn-primary">Voltar para a Home</a>
            @if (plan != "Premium")
            {
                <a asp-controller="Newsletter" asp-action="Checkout" class="btn-secondary" style="border-color: var(--red); color: var(--white);">Quero ser Premium</a>
            }
        </div>

    </div>
</div>

@section Styles {
    <style>
        .success-page {
            padding: 100px 0;
            background: linear-gradient(180deg, var(--black) 0%, var(--dark) 100%);
            min-height: calc(100vh - 68px - 140px);
            display: flex;
            align-items: center;
        }

        .success-card {
            background: var(--card);
            border: 1px solid var(--border);
            padding: 60px 40px;
            max-width: 650px !important;
            text-align: center;
            clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 20% 100%, 0 calc(100% - 20px));
            animation: cardEntrance 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* Ícone Animado */
        .success-icon-wrapper {
            display: flex;
            justify-content: center;
            margin-bottom: 30px;
        }

        .success-icon {
            width: 80px;
            height: 80px;
        }

        .success-circle {
            stroke: var(--success);
            stroke-width: 2;
            stroke-miterlimit: 10;
            stroke-dasharray: 157;
            stroke-dashoffset: 157;
            animation: strokeCircle 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;
        }

        .success-check {
            transform-origin: 50% 50%;
            stroke: var(--success);
            stroke-width: 3;
            stroke-dasharray: 48;
            stroke-dashoffset: 48;
            animation: strokeCheck 0.3s cubic-bezier(0.65, 0, 0.45, 1) 0.6s forwards;
        }

        .success-tag {
            display: inline-block;
            background: rgba(16, 185, 129, 0.1);
            color: var(--success);
            border: 1px solid rgba(16, 185, 129, 0.2);
            padding: 4px 12px;
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            font-size: 11px;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 20px;
        }

        .success-title {
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 900;
            font-style: italic;
            font-size: clamp(28px, 4vw, 44px);
            text-transform: uppercase;
            line-height: 0.95;
            letter-spacing: -0.5px;
            margin-bottom: 16px;
        }

        .success-subtitle {
            font-size: 15px;
            color: var(--muted);
            line-height: 1.6;
            margin-bottom: 30px;
        }

        .plan-badge-highlight {
            padding: 2px 8px;
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 13px;
        }

        .badge-premium {
            background: var(--red);
            color: var(--white);
        }

        .badge-gratis {
            background: #444;
            color: #ccc;
        }

        .success-details {
            background: rgba(0,0,0,0.2);
            border: 1px solid var(--border);
            padding: 20px;
            margin-bottom: 40px;
        }

        .details-text {
            font-size: 12px;
            color: var(--muted);
            margin-bottom: 6px;
        }

        .email-highlight {
            font-size: 16px;
            font-weight: 600;
            color: var(--white);
        }

        /* Próximos Passos Premium */
        .premium-next-steps {
            text-align: left;
            border-top: 1px solid var(--border);
            padding-top: 30px;
            margin-bottom: 40px;
        }

        .premium-next-steps h3 {
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            font-size: 16px;
            text-transform: uppercase;
            color: var(--white);
            margin-bottom: 20px;
        }

        .premium-next-steps ul {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .premium-next-steps li {
            display: flex;
            gap: 16px;
            align-items: flex-start;
        }

        .step-icon {
            font-size: 24px;
            line-height: 1;
        }

        .step-desc strong {
            display: block;
            font-size: 14px;
            color: var(--white);
            margin-bottom: 2px;
        }

        .step-desc p {
            font-size: 13px;
            color: var(--muted);
            line-height: 1.4;
        }

        .vip-link {
            color: var(--red);
            font-weight: bold;
            text-decoration: none;
            transition: color 0.2s;
        }

        .vip-link:hover {
            color: #ff4d4d;
            text-decoration: underline;
        }

        /* Próximos Passos Grátis */
        .free-next-steps {
            text-align: left;
            border-top: 1px solid var(--border);
            padding-top: 30px;
            margin-bottom: 40px;
        }

        .free-next-steps h3 {
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            font-size: 16px;
            text-transform: uppercase;
            color: var(--white);
            margin-bottom: 12px;
        }

        .free-next-steps p {
            font-size: 13px;
            color: var(--muted);
            line-height: 1.6;
        }

        .success-actions {
            display: flex;
            gap: 16px;
            justify-content: center;
        }

        .success-actions .btn-primary {
            min-width: 180px;
        }

        .success-actions .btn-secondary {
            min-width: 180px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        /* Animações */
        @@keyframes strokeCircle {
            100% { stroke-dashoffset: 0; }
        }

        @@keyframes strokeCheck {
            100% { stroke-dashoffset: 0; }
        }

        @@keyframes cardEntrance {
            from { opacity: 0; transform: scale(0.95) translateY(20px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        @@media (max-width: 600px) {
            .success-card {
                padding: 40px 20px;
            }
            .success-actions {
                flex-direction: column;
            }
            .success-actions .btn-primary, .success-actions .btn-secondary {
                width: 100%;
            }
        }
    </style>
}
