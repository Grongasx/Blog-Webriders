{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build)",
      "Bash(dotnet run*)",
      "Bash(dotnet ef *)",
      "Bash(dotnet test *)",
      "Bash(dotnet restore)"
    ],
    "deny": [
      "Read(./appsettings.Development.json)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  }
}
